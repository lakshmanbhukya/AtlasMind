# MongoDB Atlas connection string
MONGODB_URI=your_mongodb_connection_string_here

# Groq Cloud API key
GROQ_API_KEY=your_groq_cloud_api_key_here

# Server configuration
PORT=3001
NODE_ENV=development

# 32-byte (64 char) Hex Key for AES-256-CBC (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# JWT Secret — used to sign/verify session cookies
JWT_SECRET=your_jwt_secret_here

# Auto-cleanup configuration
PLAYGROUND_CHAT_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=24

# Comma-separated browser origins allowed by CORS (required in production)
CORS_ALLOWED_ORIGINS=general_frontend_urls_here,comma_separated

# Optional: comma-separated DNS servers (fixes Atlas SRV lookups on some Windows setups)
DNS_SERVERS=your_dns_servers_here,comma_separated

# Optional: enable POST /api/scope/suggest
SCOPE_AUTO_SUGGEST=false

# Optional: user-database client pool tuning
USER_DB_IDLE_TTL_MS=
USER_DB_MAX_CLIENTS=
