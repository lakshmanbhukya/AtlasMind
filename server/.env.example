# MongoDB Atlas connection string
MONGODB_URI=your_mongodb_connection_string_here

# Groq Cloud API key: pays for the "AtlasMind allowance" (connections without their own key)
GROQ_API_KEY=your_groq_cloud_api_key_here

# Optional: AtlasMind allowance (managed key), per UTC day. Defaults shown.
# Mode: enforce (refuse past a limit), observe (record only) or off (no accounting)
GROQ_ALLOWANCE_MODE=enforce
GROQ_GLOBAL_DAILY_TOKENS=160000
GROQ_CONNECTION_DAILY_TOKENS=25000
GROQ_GLOBAL_DAILY_AUDIO_SECONDS=3600
GROQ_CONNECTION_DAILY_AUDIO_SECONDS=600
# Comma-separated models managed traffic may use (the first is its default)
MANAGED_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Server configuration
PORT=3001
NODE_ENV=development

# 32-byte (64 char) Hex Key for AES-256-GCM (generate with: openssl rand -hex 32).
# Encrypts stored connection strings and personal Groq keys.
ENCRYPTION_KEY=

# JWT Secret — used to sign/verify session cookies
JWT_SECRET=your_jwt_secret_here

# Auto-cleanup configuration
PLAYGROUND_CHAT_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=24

# Comma-separated browser origins allowed by CORS (required in production).
# Also gates non-GET /api requests that send an Origin header (403 origin_not_allowed otherwise).
CORS_ALLOWED_ORIGINS=general_frontend_urls_here,comma_separated

# Optional: comma-separated DNS servers (fixes Atlas SRV lookups on some Windows setups)
DNS_SERVERS=your_dns_servers_here,comma_separated

# Optional: enable POST /api/scope/suggest
SCOPE_AUTO_SUGGEST=false

# Optional: user-database client pool tuning
USER_DB_IDLE_TTL_MS=
USER_DB_MAX_CLIENTS=

# Optional: log level (fatal, error, warn, info, debug, trace, silent). Default: info
LOG_LEVEL=info
