# MongoDB Atlas connection string
MONGODB_URI=

# Groq Cloud API key
GROQ_API_KEY=

# Server configuration
PORT=3001
NODE_ENV=production

# 32-byte (64 char) Hex Key for AES-256-CBC (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secret — used to sign/verify session cookies
JWT_SECRET=

# Auto-cleanup configuration
PLAYGROUND_CHAT_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=24

