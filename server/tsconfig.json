{
    // Type-checks the server's JavaScript (F19). Files opt in with `// @ts-check`
    // (checkJs stays false), and nothing is emitted. Run with `npm run typecheck`.
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "module": "commonjs",
        "target": "es2022",
        "lib": ["es2022"],
        "types": ["node"],
        "strict": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true
    },
    "include": ["src"],
    "exclude": ["src/__tests__", "src/db/seed.js"]
}
